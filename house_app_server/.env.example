# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017

# Server Configuration (optional)
# PORT=8080

# Swagger Configuration
# Set this to your machine's IP address when accessing from other devices
# For local access: localhost:8080
# For network access: 192.168.0.23:8080 (use your actual IP)
SWAGGER_HOST=localhost:8080

# Image Processing Configuration
UPLOAD_DIR=./uploads
STORAGE_DIR=E:/house_app_storage
PROCESSING_INTERVAL=5m

# AI Configuration (optional)
ENABLE_AI_CATEGORIZATION=false
# OPENAI_API_KEY=your_openai_api_key_here

# API Authentication
# If set, every /api/v1/* request must send a matching X-API-Key header.
# Leave unset only for local development — the server logs a warning and
# runs unauthenticated if this is empty.
API_KEY=

# Backup Destinations (strongly recommended)
# Without at least one of these, every uploaded photo/video exists only in
# STORAGE_DIR — one disk failure means permanent loss. Configure as many
# local drives as you have, a cloud bucket, or both; leaving all of this
# unset is allowed but logs a startup warning.

# Comma-separated list of local or network paths (external drives, a NAS
# mount, etc.) to mirror STORAGE_DIR's contents into. Any number of these,
# including zero.
# BACKUP_LOCAL_DIRS=D:/house_app_backup,E:/house_app_backup2

# Optional single S3-compatible cloud destination (AWS S3, Backblaze B2,
# Cloudflare R2, MinIO, ...). All three of BUCKET/ACCESS_KEY/SECRET_KEY
# must be set for this to activate; ENDPOINT can be left unset for AWS S3
# itself, and REGION defaults to us-east-1 if unset.
# BACKUP_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# BACKUP_S3_BUCKET=house-app-backup
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=us-west-002
