# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017

# Server Configuration (optional)
# PORT=8080

# Swagger Configuration
# Set this to your machine's IP address when accessing from other devices
# For local access: localhost:8080
# For network access: 192.168.0.23:8080 (use your actual IP)
SWAGGER_HOST=localhost:8080

# Image Processing Configuration
UPLOAD_DIR=./uploads
STORAGE_DIR=E:/house_app_storage
PROCESSING_INTERVAL=5m

# AI Configuration (optional)
ENABLE_AI_CATEGORIZATION=false
# OPENAI_API_KEY=your_openai_api_key_here

# API Authentication
# If set, every /api/v1/* request must send a matching X-API-Key header.
# Leave unset only for local development — the server logs a warning and
# runs unauthenticated if this is empty.
API_KEY=
